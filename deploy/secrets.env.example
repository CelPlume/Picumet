# 生产密钥清单。复制为 deploy/secrets.env 填写真实值；
# 应用命令、轮换与初始账号（管理员由 seed 自动创建）说明见 docs/DEPLOYMENT_CN.md「deploy/ 部署配置目录」。
# 随机值生成：openssl rand -base64 32

# —— 必需 ——

# JWT 会话签名密钥（≥32 字节随机值）。轮换时把旧值挪到 JWT_SECRET_OLD 再写新值。
JWT_SECRET='替换为 openssl rand -base64 32 的输出'
# 轮换窗口内的旧签名密钥（可选），过期后清空。
JWT_SECRET_OLD=''
# AES-256-GCM 加密密钥（≥32 字符）：提供商凭据 / 分享密码回看 / SSO 密钥 / API Key secret。
# ⚠️ 更换后既有密文不可解密，需在管理端重新保存。
ENCRYPTION_KEY='替换为 openssl rand -base64 32 的输出'
# 初始管理员密码（首次启动 seed 自动创建管理员，用户名 = ADMIN_USERNAME，默认 admin）：
# ≥12 位且同时含字母和数字；缺失时不建号，业务 API 一律 503 INITIALIZATION_REQUIRED。
ADMIN_PASSWORD='替换为强密码（至少12位且含字母和数字）'
# 初始管理员用户名（可选，默认 admin）。
ADMIN_USERNAME='admin'

# —— 可选：SMTP 邮件发送（邮箱验证码/密码重置），未配置则对应功能不可用 ——
# 端口语义：仅 465 走隐式 TLS（服务商的 994 也是隐式 SSL 时请改填 465）；
# 其余端口按服务器宣告升级 STARTTLS，或用 SMTP_SECURE='true'/'false' 强制/禁用。

SMTP_HOST=''
SMTP_PORT='587'
SMTP_USER=''
SMTP_PASS=''
SMTP_FROM='Picumet <noreply@example.com>'
