# 本地开发环境变量（复制为 .dev.vars）
JWT_SECRET=dev-secret-change-me-please-32-chars-min
JWT_SECRET_OLD=
ENCRYPTION_KEY=dev-encryption-key-32-characters-minimum!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Picumet <noreply@example.com>
ENVIRONMENT=development
# 初始管理员（审计 H-02）：生产必填强密码；开发默认 admin/admin123456，可在此覆盖
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEMO_PASSWORD=
