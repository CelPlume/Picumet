# 本地开发环境变量（复制为 .dev.vars）
JWT_SECRET=dev-secret-change-me-please-32-chars-min
JWT_SECRET_OLD=
ENCRYPTION_KEY=dev-encryption-key-32-characters-minimum!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Picumet <noreply@example.com>
ENVIRONMENT=development
# SSO/OIDC 本地联调：允许回环 issuer（本地 IdP 容器）。生产不要设置该变量。
SSO_ALLOW_LOOPBACK=true
# 初始管理员：生产必填强密码；开发默认 admin/admin123456，可在此覆盖
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEMO_PASSWORD=
