{
  "name": "picumet-workers",
  "version": "1.0.0",
  "private": true,
  "description": "Picumet API - Cloudflare Workers + Hono",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "db:migrate:local": "wrangler d1 execute picumet-db --local --file=migrations/0001_initial.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20241127.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20260811.1": true,
    "esbuild@0.21.5": true
  }
}
